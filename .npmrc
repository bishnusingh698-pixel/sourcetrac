# Render builds with devDependencies omitted, but `react-router build` loads
# vite.config.ts, which imports vite and vite-tsconfig-paths — both
# devDependencies. Without them the build dies with ERR_MODULE_NOT_FOUND.
#
# `include=dev` re-adds them without undoing the production omit, so the
# deployed image stays lean. Do NOT move build-time-only packages into
# `dependencies` to work around this; that is the wrong fix and bloats the
# runtime image.
#
# Guarded by `npm run check:build-deps`.
include=dev

# The checkout extensions pull in @remote-ui/react, which pins React <19 while
# the admin app runs React 19. npm cannot satisfy both, and a plain `npm install`
# hard-fails on ERESOLVE. This matters beyond local work: `shopify app deploy`
# shells out to a bare `npm install`, so without this the deploy itself dies
# before it can bundle the extensions.
#
# legacy-peer-deps is the narrower fix than --force: it only relaxes peer
# *resolution*, and cannot rewrite the dependency tree the way --force can.
legacy-peer-deps=true
