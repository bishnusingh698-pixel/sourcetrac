# Render builds with devDependencies omitted, but `react-router build` loads
# vite.config.ts, which imports vite and vite-tsconfig-paths — both
# devDependencies. Without them the build dies with ERR_MODULE_NOT_FOUND.
#
# `include=dev` re-adds them without undoing the production omit, so the
# deployed image stays lean. Do NOT move build-time-only packages into
# `dependencies` to work around this; that is the wrong fix and bloats the
# runtime image.
#
# Guarded by `npm run check:build-deps`.
include=dev

# legacy-peer-deps skips peer-dependency resolution. It was added because the
# old React/remote-ui checkout binding required React < 19 while the admin runs
# React 19; that binding is gone (the extensions now use Preact), and an install
# without this flag resolves cleanly. Beware what it hides: the same flag let a
# React-18-only reconciler install against React 19, and the survey block
# crashed on every page with no warning at install time.
# Kept for now because removing it adds 63 peer packages to every Render build;
# drop it in a change of its own. tests/integration/extension-bundle.test.ts
# builds and runs both blocks, so a recurrence fails `npm run check`.
legacy-peer-deps=true
