# SourceTrac environment — copy to .env and fill in. Never commit .env.
# Every value marked REQUIRED will fail the boot-time Zod check in app/lib/env.ts.

# ---------------------------------------------------------------------------
# Shopify app credentials (Admin dashboard → Settings → Apps and sales channels)
# ---------------------------------------------------------------------------
SHOPIFY_API_KEY=REQUIRED           # Client ID (also the extension's public api key)
SHOPIFY_API_SECRET=REQUIRED        # Client secret — server-side ONLY, never in an extension
SCOPES=read_orders                 # Single scope; keep in sync with shopify.app.toml
SHOPIFY_API_VERSION=2026-07        # Keep identical to shopify.app.toml and both extensions

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
# Public base URL. Must be HTTPS in production: Shopify requires TLS for
# embedded apps and for webhook delivery. Local dev uses the CLI tunnel URL.
APP_URL=REQUIRED                   # https://sourcetrac.onrender.com

# Same URL, read by the two checkout UI extensions at build time. Must match
# APP_URL, and its host must be covered by the Partner Dashboard network-access
# opt-in the extensions depend on.
# Injected into the extension bundle by `shopify app dev`, not read from here at
# runtime by the server.
API_URL=REQUIRED                   # https://sourcetrac.onrender.com
NODE_ENV=development
LOG_LEVEL=debug
SUPPORT_EMAIL=support@example.com  # shown on the in-app Help page

# ---------------------------------------------------------------------------
# Database (Neon) — use the POOLED connection string for the server
# ---------------------------------------------------------------------------
DATABASE_URL=REQUIRED              # postgresql://user:pass@ep-xxx-pooler.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# 32-byte hex key for AES-256-GCM over access tokens. Generate:
#   openssl rand -hex 32
# Rotating this without re-encrypting orphaned tokens locks every shop out.
TOKEN_ENCRYPTION_KEY=REQUIRED

# ---------------------------------------------------------------------------
# Checkout UI extension targets (asserted at boot; sanity checks only)
# ---------------------------------------------------------------------------
PUBLIC_EXTENSION_CHECKOUT_TARGET=purchase.thank-you.block.render
PUBLIC_EXTENSION_ORDER_STATUS_TARGET=customer-account.order-status.block.render