# SourceTrac environment — copy to .env and fill in. Never commit .env.
# Every value marked REQUIRED will fail the boot-time Zod check in app/lib/env.ts.

# ---------------------------------------------------------------------------
# Shopify app credentials (Admin dashboard → Settings → Apps and sales channels)
# ---------------------------------------------------------------------------
SHOPIFY_API_KEY=REQUIRED           # Client ID (also the extension's public api key)
SHOPIFY_API_SECRET=REQUIRED        # Client secret — server-side ONLY, never in an extension
SCOPES=read_orders,write_orders,read_products  # keep in sync with shopify.app.toml; sync features gate on granted scopes
SHOPIFY_API_VERSION=2026-07        # Optional. Pinned in code (API_VERSION in app/lib/env.ts); any other value refuses to boot

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
# Public base URL. Must be HTTPS in production: Shopify requires TLS for
# embedded apps and for webhook delivery. Local dev uses the CLI tunnel URL.
APP_URL=REQUIRED                   # https://sourcetrac.onrender.com

# Informational only: nothing reads this. The two checkout UI extensions run in
# a Web Worker with no `process.env`, so their backend URL is the literal
# `API_URL` constant in extensions/*/src/*Block.tsx. If you move the backend,
# change those constants (and allowed_urls in each shopify.extension.toml) and
# run `shopify app deploy`; changing this value does nothing.
API_URL=https://sourcetrac.onrender.com
NODE_ENV=development
LOG_LEVEL=debug
# The support email is a code constant, not config: see shared/support.ts
# (SUPPORT_EMAIL). It is shown on the in-app Help page and in the privacy policy.

# Shared secret for POST /jobs/retention. Required in production: the route
# fails closed (503) without it rather than running an unauthenticated delete.
# Generate with: openssl rand -hex 32
RETENTION_JOB_SECRET=
# Optional secret for GET /readyz (header x-readyz-secret), so a monitor does
# not need the retention secret. Falls back to RETENTION_JOB_SECRET when unset.
READYZ_SECRET=

# ---------------------------------------------------------------------------
# Database (Neon) — use the POOLED connection string for the server
# ---------------------------------------------------------------------------
DATABASE_URL=REQUIRED              # postgresql://user:pass@ep-xxx-pooler.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=                        # optional; Neon direct (non-pooler) URL for migrations. Derived from DATABASE_URL if blank

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# 32-byte hex key for AES-256-GCM over access tokens. Generate:
#   openssl rand -hex 32
# Rotating this without re-encrypting orphaned tokens locks every shop out.
TOKEN_ENCRYPTION_KEY=REQUIRED
# Optional, only while rotating TOKEN_ENCRYPTION_KEY: the old key, so tokens
# sealed with it still decrypt (and are re-sealed with the new one when stored).
TOKEN_ENCRYPTION_KEY_PREVIOUS=
