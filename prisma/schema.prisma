// SourceTrac data model.
// Rationale for every column lives in docs/02-architecture-and-costs.md §3.
// Flow-by-flow behaviour lives in docs/03-logic-spec.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  free
  growth
  scale
}

enum PlanStatus {
  active
  cancelled
  declined
  frozen
  expired
}

enum InstallState {
  installed
  uninstalled
}

/// Survey status. Draft and Paused are invisible to shoppers; only Active shows.
enum SurveyStatus {
  draft
  active
  paused
}

/// Buyer-facing layout for a survey.
enum SurveyLayout {
  all
  one_by_one
}

/// Question type. Mirrors QUESTION_TYPES in shared/survey-rules.ts.
enum QuestionType {
  single_choice
  multi_choice
  dropdown
  yes_no
  rating_5
  satisfaction_5
  nps
  text
}

/// What a pending Shopify write is for. See PendingSync.
enum PendingSyncKind {
  metafield
  tags
  customer
  flow
}

/// What a deferred deletion covers. See PendingDeletion.
enum PendingDeletionScope {
  shop
  customer
}

/// Where a response was collected.
enum SurveyPlacement {
  thank_you
  order_status
  onsite
  link
}

/// One row per merchant store. Access tokens are AES-256-GCM encrypted at rest.
model Shop {
  id                   String       @id @default(cuid())
  shopDomain           String       @unique
  shopId               String       @unique
  accessTokenEncrypted String?
  accessTokenIv        String?
  accessTokenTag       String?
  installState         InstallState @default(installed)
  uninstalledAt        DateTime?
  /// When the current installation began. A late app/uninstalled or
  /// shop/redact from an earlier installation is recognised by it.
  installedAt          DateTime?
  plan                 Plan         @default(free)
  planStatus           PlanStatus   @default(active)
  subscriptionGid      String?
  planDisplayName      String?
  checkoutSupported    Boolean?
  checkoutCheckedAt    DateTime?
  /// When a SourceTrac checkout block last asked us for a survey on each page,
  /// from a buyer's order or the checkout editor. Shopify reports no "block
  /// added" state, so this is the only proof the block is really there. Null
  /// means never seen; cleared on uninstall, which removes the blocks.
  thankYouBlockSeenAt    DateTime?
  orderStatusBlockSeenAt DateTime?
  questionText         String       @default("How did you hear about us?")
  /// Defaulted so a shop row is always valid: a freshly installed store must be
  /// able to render a working survey before the merchant visits Settings.
  optionsJson          String       @default("[]")
  allowOther           Boolean      @default(false)
  /// Merchant's chosen admin UI language, e.g. "de" or "pt-BR". Null means they
  /// have never chosen one, so we fall back to detecting Shopify's admin locale.
  /// Deliberately a free String rather than an enum: adding a language must not
  /// require a migration, and `resolveLanguage` already rejects anything we do
  /// not ship, so a stale value degrades to English instead of erroring.
  language             String?
  /// The Shopify admin's own locale (`?locale=` on the first document load),
  /// remembered because later in-app navigations do not carry it. Only a
  /// fallback below `language`; never set by the merchant directly.
  adminLocale          String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  responses   SurveyResponse[]
  orders      OrderCache[]
  usage       BillingUsage[]
  webhookLogs WebhookEvent[]

  surveys          Survey[]
  surveyResponses  Response[]
  answers          Answer[]
  dailyStats       SurveyDailyStats[]
  pendingSyncs     PendingSync[]
  pendingDeletions PendingDeletion[]
  dataRequests     DataRequest[]
  redactedOrders   RedactedOrder[]
  orderFacts       OrderFact[]

  @@index([installState])
}

/// One row per buyer answer. `orderTotal` is denormalised from OrderCache so the
/// dashboard reads a single indexed table instead of joining. Null means the
/// orders/create webhook has not landed yet — render as "Pending", never $0.00.
///
/// DEPRECATED (Phase 2). Superseded by the multi-question `Response` + `Answer`
/// models below. Kept, and still written for the single-question survey, so the
/// already-deployed checkout extension keeps working and no data is lost. A
/// cleanup migration to drop this model is tracked in FUTURE_TASKS.md.
model SurveyResponse {
  id             String   @id @default(cuid())
  shopId         String
  orderId        String
  channel        String
  otherText      String?
  currency       String?
  /// Stored in MAJOR units, not minor. Three fractional places because KWD, BHD,
  /// OMR and friends are three-decimal currencies; Decimal(12,2) would round a
  /// 1.234 KWD order to 1.23 on insert and silently lose the difference.
  orderTotal     Decimal? @db.Decimal(18, 3)
  locale         String?
  submittedAt    DateTime @default(now())
  isLocked       Boolean  @default(false)
  reconciled     Boolean  @default(false)
  /// Set when the order webhook never arrived within 24h. Excluded from
  /// revenue, never deleted.
  unreconcilable Boolean  @default(false)
  createdAt      DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, orderId])
  @@index([shopId, submittedAt])
  @@index([shopId, channel])
  @@index([shopId, isLocked])
  @@index([shopId, reconciled])
  @@index([shopId, orderId])
}

/// Cached order facts from webhooks. Never holds customer PII.
model OrderCache {
  id              String    @id @default(cuid())
  shopId          String
  orderId         String
  orderNumber     String?
  currency        String
  /// Major units, three fractional places for three-decimal currencies. See
  /// SurveyResponse.orderTotal.
  /// Shopify's current_total_price: ALREADY net of refunds, returns and edits.
  /// This is the only revenue figure; nothing may subtract a refund from it.
  /// Null when the webhook total could not be parsed (never a fake 0.00).
  totalPrice      Decimal?  @db.Decimal(18, 3)
  financialStatus String?
  isTest          Boolean   @default(false)
  isCancelled     Boolean   @default(false)
  cancelledAt     DateTime?
  createdAtShop   DateTime
  updatedAtShop   DateTime
  /// X-Shopify-Triggered-At of the delivery that wrote this row. Breaks ties
  /// between two updates in the same second of `updated_at`.
  triggeredAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, orderId])
  @@index([shopId, updatedAtShop])
  @@index([shopId, isTest, isCancelled])
}

/// Idempotency ledger. `webhookId` is X-Shopify-Webhook-Id; the unique
/// constraint makes insert-first atomic, so a Shopify retry can redo partial
/// work while a completed delivery costs nothing.
///
/// `payloadJson` is deliberately never written. An orders/* payload embeds a
/// full customer object (name, email, phone, address) that this app has no use
/// for, and no code path reads the column back. Keeping it nullable means the
/// historic rows still age out through the 30-day retention purge.
model WebhookEvent {
  id          String    @id @default(cuid())
  shopId      String?
  webhookId   String    @unique
  topic       String
  apiVersion  String?
  triggerRef  String?
  payloadJson String?
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  shop Shop? @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
  @@index([processedAt])
}

/// Monthly response counter for the Free-plan cap. Boundaries are UTC
/// (docs/03 FLOW 15). Increment happens even when isLocked is set, so the
/// merchant sees true volume.
model BillingUsage {
  id             String   @id @default(cuid())
  shopId         String
  periodStart    DateTime
  periodEnd      DateTime
  responsesCount Int      @default(0)
  cap            Int?
  updatedAt      DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, periodStart])
  @@index([shopId, periodStart])
}

/// Session storage for the embedded admin. Managed by
/// @shopify/shopify-app-session-storage-prisma; do not hand-edit.
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String?
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  // Written on every store by @shopify/shopify-app-session-storage-prisma v11
  // (expiring offline tokens). Without them every login fails validation.
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

// ---------------------------------------------------------------------------
// Multi-question survey model (Phase 2).
//
// Added alongside the deprecated single-question columns on Shop and the
// SurveyResponse model, which are retained so nothing that works today breaks.
// Every existing shop/response is backfilled into these tables by the migration.
// ---------------------------------------------------------------------------

/// A survey: one or more questions shown to shoppers on chosen placements.
model Survey {
  id         String       @id @default(cuid())
  shopId     String
  name       String
  status     SurveyStatus @default(draft)
  /// Higher wins when several surveys match an order.
  priority   Int          @default(0)
  /// Placement keys: "thank_you", "order_status", "onsite", "link".
  placements String       @default("[]")
  layout     SurveyLayout @default(all)

  title        String?
  intro        String?
  buttonLabel  String?
  thankYouText String?
  /// locale -> { title, intro, buttonLabel, thankYouText, questions: {...} }
  translations String  @default("{}")

  /// JSON: customerType, minValue, maxValue, valueCurrency, productIds,
  /// collectionIds, resolvedProductIds, countries, languages, samplePercent,
  /// startsAt, endsAt, maxResponses.
  targeting               String  @default("{}")
  /// The question whose answer feeds the "how did you hear about us" report.
  channelReportQuestionId String?
  /// JSON: per-survey sync overrides (tags, metafields, flow).
  syncOptions             String  @default("{}")

  /// Incremented on every save of an active survey. Responses store the version
  /// they answered.
  version       Int      @default(1)
  responseCount Int      @default(0)
  /// Template provenance, for display and analytics only. A survey is an
  /// independent copy: template updates never touch it.
  templateId      String?
  templateVersion Int?
  /// T11: join this survey into the rotation group for its placements.
  rotation       Boolean @default(false)
  /// 1 (low) / 2 (normal) / 3 (high). Weighted, deterministic per order.
  rotationWeight Int     @default(2)
  /// T10: pause automatically once results are reliable.
  learnAndStop   Boolean @default(false)
  /// When learn & stop paused the survey. Set once: a merchant who resumes an
  /// auto-paused survey keeps it running (it used to re-pause on the very next
  /// answer), and the editor says why the survey was paused.
  autoPausedAt   DateTime?
  /// S11/S12 design settings (JSON). Empty means the defaults.
  designJson     String  @default("{}")
  /// S7: the full editable definition held back while a live survey keeps
  /// running the published version. Null when there are no unpublished changes.
  draft          String?
  draftUpdatedAt DateTime?
  /// Optimistic-concurrency token (section 6.6). The editor posts back the value
  /// it loaded; a mismatch means another window changed the survey. Bumped on
  /// every save, publish and status change. Not `@updatedAt`, so answer counting
  /// (which increments `responseCount`) cannot raise a false conflict.
  revision      Int      @default(0)
  /// Last merchant change (save, publish, discard, status). Shown as "Updated"
  /// on the survey list; `updatedAt` also moves on every buyer answer.
  editedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shop       Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  questions  Question[]
  responses  Response[]
  dailyStats SurveyDailyStats[]

  @@index([shopId, status, priority])
}

/// One question in a survey.
model Question {
  id               String       @id @default(cuid())
  surveyId         String
  position         Int
  type             QuestionType
  text             String
  helpText         String?
  placeholder      String?
  /// For `text`: multi-line when true.
  textMultiline    Boolean      @default(false)
  required         Boolean      @default(false)
  randomizeOptions Boolean      @default(false)
  allowOther       Boolean      @default(false)
  minSelections    Int?
  maxSelections    Int?
  /// JSON: { questionId, optionIds[] } or { questionId, min, max }.
  showIf           String?
  tagPrefix        String?
  /// locale -> { text, helpText, placeholder }
  translations     String       @default("{}")
  /// Archived questions are hidden from shoppers but keep their results.
  archived         Boolean      @default(false)
  /// The template's stable question id this row was created from, if any.
  templateKey      String?

  survey  Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  options Option[]
  answers Answer[]

  @@index([surveyId, position])
}

/// One answer option. `id` is stable: labels can change, ids never do.
model Option {
  id           String  @id @default(cuid())
  questionId   String
  position     Int
  label        String
  isOther      Boolean @default(false)
  /// T6: selecting it clears other selections in multiple choice.
  exclusive    Boolean @default(false)
  /// Hidden from shoppers; still shown in results as "(removed) Label".
  archived     Boolean @default(false)
  /// locale -> translated label.
  translations String  @default("{}")
  /// The template's stable option id this row was created from, if any.
  templateKey  String?

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, position])
}

/// One shopper's full set of answers to one survey (one order, or one on-site visit).
model Response {
  id            String @id @default(cuid())
  shopId        String
  surveyId      String
  surveyVersion Int

  /// Numeric order id, or null for on-site / link responses with no order.
  orderId      String?
  customerId   String?
  orderTotal   Decimal? @db.Decimal(18, 3)
  currency     String?
  isFirstOrder Boolean?
  /// T8: product ids on this order, from the checkout lines. Max 10. Null on
  /// rows that predate the column.
  productIds   String?  @default("[]")

  placement SurveyPlacement
  locale    String?
  country   String?
  flagged   Boolean         @default(false)
  /// Order verification snapshot. `null` = the row predates verification (the
  /// migration backfills existing rows to null); `true` = a known, countable
  /// order (not test, not cancelled) whose real total is stored; `false` = the
  /// order is unknown or not countable, so revenue is excluded.
  verified  Boolean?
  /// Set when the order never arrived within 24h and no total could be attached,
  /// so the row is no longer Pending but deliberately excluded from revenue.
  unverifiedFailed Boolean @default(false)
  createdAt DateTime        @default(now())

  shop    Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  survey  Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers Answer[]

  /// Duplicate protection. Null orderId rows are on-site/link and are not
  /// deduplicated by this constraint (Postgres treats NULLs as distinct).
  @@unique([shopId, surveyId, orderId])
  @@index([shopId, createdAt])
  @@index([shopId, surveyId, createdAt])
}

/// One answer to one question within a Response.
model Answer {
  id         String @id @default(cuid())
  shopId     String
  responseId String
  questionId String

  /// Choice answers: option ids (one for single, several for multi).
  optionIds   String  @default("[]")
  /// Numeric answers: rating 1–5, NPS 0–10, yes = 1 / no = 0.
  numberValue Int?
  /// Free-text answers, capped at 500 characters.
  textValue   String?
  /// The typed text when the "Other" option was chosen.
  otherText   String?

  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  response Response @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([responseId])
  @@index([questionId])
}

/// Pre-counted totals, updated in the same transaction as each response insert.
/// Default (unfiltered) results read this table instead of raw answers.
model SurveyDailyStats {
  shopId     String
  surveyId   String
  questionId String
  /// UTC day key "YYYY-MM-DD" (a plain string, not a timestamp, so no zone drift).
  day        String
  /// Option id, numeric value as text, or "_responses" for the response count.
  bucket     String
  count      Int     @default(0)
  revenue    Decimal @default(0) @db.Decimal(18, 3)
  currency   String  @default("")

  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@id([surveyId, questionId, day, bucket, currency])
  @@index([shopId, surveyId, day])
}

/// A Shopify write that could not run at submit time (order not created yet, or
/// the API was throttled). Retried lazily; deleted after success or 5 attempts.
model PendingSync {
  id            String          @id @default(cuid())
  shopId        String
  responseId    String
  kind          PendingSyncKind
  attempts      Int             @default(0)
  nextAttemptAt DateTime        @default(now())
  lastError     String?
  createdAt     DateTime        @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, nextAttemptAt])
}

/// A deletion too large to finish inside a webhook's 5-second budget. Recorded
/// synchronously, then executed in batches lazily.
model PendingDeletion {
  id        String               @id @default(cuid())
  shopId    String
  scope     PendingDeletionScope
  /// JSON payload, e.g. { orderIds: [...] } for a customer redact.
  payload   String               @default("{}")
  createdAt DateTime             @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
}

/// An order a customers/redact named. Its data is never stored again: a later
/// orders/updated or a new answer for it is ignored. Kept on the record
/// retention clock.
model RedactedOrder {
  shopId    String
  orderId   String
  createdAt DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([shopId, orderId])
  @@index([createdAt])
}

/// What the Thank-you page told us about an order that the Order status page
/// cannot see: whether it was the buyer's first order with the shop. The
/// Order status page has no first-order signal, so a "first-time buyers" or
/// "returning buyers" survey could never show there. Written when the
/// Thank-you block loads; no buyer data, only the order id and the flag.
/// Deleted with the shop, on customers/redact, and after 90 days.
model OrderFact {
  shopId       String
  orderId      String
  isFirstOrder Boolean
  createdAt    DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([shopId, orderId])
  @@index([createdAt])
}

/// A stored customers/data_request export, shown on Settings for 30 days.
model DataRequest {
  id         String   @id @default(cuid())
  shopId     String
  customerId String?
  payload    String
  createdAt  DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
}
