{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2022",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["es2022", "dom"]
  },
  "include": [
    "extensions/sourcetrac-order-admin/src/**/*",
    "extensions/sourcetrac-customer-admin/src/**/*",
    "extensions/shared/src/admin-response-block.tsx"
  ]
}
