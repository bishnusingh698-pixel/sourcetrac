{
  "name": "sourcetrac",
  "private": true,
  "sideEffects": false,
  "version": "1.0.0",
  "type": "module",
  "author": "SourceTrac",
  "scripts": {
    "build": "react-router build",
    "dev": "shopify app dev",
    "start": "react-router-serve ./build/server/index.js",
    "setup": "prisma generate && prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "typecheck": "react-router typegen && tsc --noEmit",
    "typecheck:extensions": "tsc -p tsconfig.extension.json",
    "check:extensions": "node scripts/check-extensions.cjs",
    "check": "npm run typecheck && npm run typecheck:extensions && npm run check:extensions && npm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run tests/db-invariants.test.ts",
    "docker-start": "npm run setup && npm run start",
    "shopify": "shopify",
    "prisma": "prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@react-router/dev": "^7.18.2",
    "@react-router/fs-routes": "^7.18.2",
    "@react-router/node": "^7.18.2",
    "@react-router/serve": "^7.18.2",
    "@shopify/polaris-types": "^1.1.0",
    "@shopify/shopify-app-react-router": "^3.0.1",
    "@shopify/shopify-app-session-storage-prisma": "^11.0.0",
    "@shopify/ui-extensions": "2025.7.4",
    "@shopify/ui-extensions-react": "2025.7.4",
    "isbot": "^5.2.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@shopify/cli": "^4.8.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "prisma": "^6.19.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
